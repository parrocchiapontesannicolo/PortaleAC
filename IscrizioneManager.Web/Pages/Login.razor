@page "/login"
@layout EmptyLayout
@inject AuthService AuthService
@inject AppState AppState
@inject NavigationManager Navigation

<PageTitle>Accedi - Portale AC</PageTitle>

<div class="login-page">
    <MudPaper Elevation="4" Class="login-card pa-6 pa-sm-8">
        <MudStack Spacing="1" AlignItems="AlignItems.Center" Class="mb-6">
            <MudAvatar Color="Color.Primary" Size="Size.Large">
                <MudIcon Icon="@Icons.Material.Filled.Diversity3" />
            </MudAvatar>
            <MudText Typo="Typo.h5">Portale AC</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Accedi con il tuo account</MudText>
        </MudStack>

        @if (_caricamento)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            @if (AuthService.RipristinoDaRiprovare)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                    Server non raggiungibile: la sessione salvata non è andata persa.
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" Class="ml-2"
                               OnClick="RiprovaConnessione" Disabled="_ripristinoInCorso">Riprova connessione</MudButton>
                </MudAlert>
            }
            else if (!string.IsNullOrEmpty(_avvisoRipristino))
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@_avvisoRipristino</MudAlert>
            }

            @if (!string.IsNullOrEmpty(_erroreAccount))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
                    @_erroreAccount
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" Class="ml-2"
                               OnClick="CaricaAccountAsync">Riprova</MudButton>
                </MudAlert>
            }

            <EditForm Model="this" OnSubmit="Accedi">
                <MudStack Spacing="4">
                    <MudSelect T="LoginAccount" @bind-Value="_account" Label="Account" Variant="Variant.Outlined"
                               ToStringFunc="@(a => a?.Nome)" AnchorOrigin="Origin.BottomCenter"
                               Disabled="_inCorso" AdornmentIcon="@Icons.Material.Filled.Badge">
                        @foreach (var a in _accounts)
                        {
                            <MudSelectItem T="LoginAccount" Value="a">@a.Nome</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField T="string" @bind-Value="_password" Label="Password" Variant="Variant.Outlined"
                                  InputType="@(_mostraPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_mostraPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="() => _mostraPassword = !_mostraPassword"
                                  AdornmentAriaLabel="Mostra password"
                                  Disabled="_inCorso" autocomplete="current-password" />

                    @if (!string.IsNullOrEmpty(_errore))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@_errore</MudAlert>
                    }

                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Large" FullWidth="true" Disabled="_inCorso || _account == null">
                        @if (_inCorso)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Accesso in corso…</span>
                        }
                        else
                        {
                            <span>Accedi</span>
                        }
                    </MudButton>
                </MudStack>
            </EditForm>
        }
    </MudPaper>
</div>

@code {
    private List<LoginAccount> _accounts = new();
    private LoginAccount? _account;
    private string _password = string.Empty;
    private bool _mostraPassword;
    private bool _caricamento = true;
    private bool _inCorso;
    private bool _ripristinoInCorso;
    private string? _errore;
    private string? _erroreAccount;
    private string? _avvisoRipristino;

    protected override async Task OnInitializedAsync()
    {
        if (AppState.IsAuthenticated)
        {
            Navigation.NavigateTo(AppState.HasEvento ? Rotte.Home : Rotte.Eventi);
            return;
        }

        await CaricaAccountAsync();
        _caricamento = false;
    }

    private async Task CaricaAccountAsync()
    {
        _erroreAccount = null;
        try
        {
            _accounts = await AuthService.GetLoginAccountsAsync();
            if (_accounts.Count == 1)
                _account = _accounts[0];
            else if (_account != null)
                _account = _accounts.FirstOrDefault(a => a.Email == _account.Email);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Caricamento account: {ex}");
            _erroreAccount = "Impossibile contattare il server per caricare gli account. Controlla la connessione e riprova.";
        }
    }

    /// <summary>Riprova il ripristino della sessione salvata, fallito per problemi di rete.</summary>
    private async Task RiprovaConnessione()
    {
        if (_ripristinoInCorso)
            return;

        _ripristinoInCorso = true;
        _avvisoRipristino = null;
        try
        {
            if (await AuthService.TryRestoreSessionAsync())
            {
                Navigation.NavigateTo(AppState.HasEvento ? Rotte.Home : Rotte.Eventi);
                return;
            }

            if (!AuthService.RipristinoDaRiprovare)
                _avvisoRipristino = "La sessione salvata non è più valida: accedi di nuovo con la password.";
            if (_accounts.Count == 0)
                await CaricaAccountAsync();
        }
        finally
        {
            _ripristinoInCorso = false;
        }
    }

    private async Task Accedi()
    {
        if (_account == null || _inCorso)
            return;

        _inCorso = true;
        _errore = null;
        try
        {
            await AuthService.SignInAsync(_account, _password);
            Navigation.NavigateTo(AppState.HasEvento ? Rotte.Home : Rotte.Eventi);
        }
        catch (Exception ex)
        {
            // AuthService restituisce già messaggi leggibili
            _errore = ex.Message;
            _password = string.Empty;
        }
        finally
        {
            _inCorso = false;
        }
    }
}
