@* Campo password con "mostra", "genera" e "copia": le password degli account
   condivisi vanno comunicate a un gruppo, quindi è comodo vederle e copiarle. *@
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudTextField T="string" Value="Value" ValueChanged="OnValueChanged" Label="@Label" Variant="Variant.Outlined"
              InputType="@(_mostra ? InputType.Text : InputType.Password)"
              Adornment="Adornment.End"
              AdornmentIcon="@(_mostra ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
              OnAdornmentClick="() => _mostra = !_mostra" AdornmentAriaLabel="Mostra o nascondi la password"
              Immediate="true" Disabled="Disabled" autocomplete="new-password"
              Error="@(_toccato && Errore != null)" ErrorText="@Errore"
              HelperText="@($"Almeno {AdminLogica.PasswordMinLength} caratteri")" />

<MudStack Row="true" Spacing="1" Class="mt-1" Wrap="Wrap.Wrap">
    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AutoFixHigh"
               OnClick="Genera" Disabled="Disabled">Genera password</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy"
               OnClick="Copia" Disabled="@(Disabled || string.IsNullOrEmpty(Value))">Copia</MudButton>
</MudStack>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Password";
    [Parameter] public bool Disabled { get; set; }

    private bool _mostra;
    private bool _toccato;

    private string? Errore => AdminLogica.ValidaPassword(Value);

    private async Task OnValueChanged(string valore)
    {
        _toccato = true;
        await ValueChanged.InvokeAsync(valore ?? string.Empty);
    }

    private async Task Genera()
    {
        _mostra = true;
        _toccato = true;
        await ValueChanged.InvokeAsync(AdminLogica.GeneraPassword());
    }

    private async Task Copia()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Value);
            Snackbar.Add("Password copiata negli appunti", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Copia non riuscita: " + ex.Message, Severity.Warning);
        }
    }
}
