@* Modulo iscrizione condiviso tra "Nuova iscrizione" e "Dettaglio iscritto".
   I pulsanti di salvataggio sono nelle pagine: qui ci sono i campi e ValidaAsync(). *@
@using System.Globalization
@using IscrizioneManager.Core.Models
@using IscrizioneManager.Core.Utils
@using IscrizioneManager.Web.Services
@inject ModuloIscrizioneViewModel ViewModel
@inject AppState AppState

@if (_caricamento)
{
    <MudStack Spacing="3">
        @for (var i = 0; i < 3; i++)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudSkeleton Width="35%" Height="28px" />
                <MudSkeleton Height="52px" />
                <MudSkeleton Height="52px" />
            </MudPaper>
        }
    </MudStack>
}
else if (_erroreCaricamento != null || _dati == null)
{
    <MudAlert Severity="Severity.Error">
        Impossibile caricare il modulo: @_erroreCaricamento
        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="ml-2" OnClick="CaricaAsync">Riprova</MudButton>
    </MudAlert>
}
else
{
    var meta = _dati.Metadata;

    <MudForm @ref="_form" Model="FormModel" ReadOnly="SolaLettura" Disabled="Disabled" FieldChanged="@(_ => NotificaModificaAsync())">
        <MudStack Spacing="3">

            @* ================= BAMBINO ================= *@
            <MudPaper Outlined="true" Class="pa-3 pa-sm-4">
                @(Intestazione(Icons.Material.Outlined.ChildCare, "Bambino", EtaDesc))
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="FormModel.Cognome" Label="Cognome" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Required="true" RequiredError="Il cognome è obbligatorio" autocomplete="off" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="FormModel.Nome" Label="Nome" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Required="true" RequiredError="Il nome è obbligatorio" autocomplete="off" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="DateTime?" @bind-Value="FormModel.DataNascita" Label="Data di nascita" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" InputType="InputType.Date" Format="yyyy-MM-dd" ShrinkLabel="true"
                                      Required="true" RequiredError="La data di nascita è obbligatoria" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Genere *</MudText>
                        <MudRadioGroup T="int?" @bind-Value="FormModel.Genere" Required="true" RequiredError="Il genere è obbligatorio">
                            <MudRadio T="int?" Value="1" Color="Color.Primary" Dense="true">Maschio</MudRadio>
                            <MudRadio T="int?" Value="2" Color="Color.Primary" Dense="true">Femmina</MudRadio>
                        </MudRadioGroup>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField T="string" @bind-Value="FormModel.LuogoNascita" Label="Luogo di nascita" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField T="string" @bind-Value="FormModel.IndirizzoResidenza" Label="Indirizzo di residenza" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField T="string" @bind-Value="FormModel.ComuneResidenza" Label="Comune di residenza" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @* ================= GENITORI ================= *@
            @if (meta.View_Genitori || meta.View_MailGenitore)
            {
                <MudPaper Outlined="true" Class="pa-3 pa-sm-4">
                    @(Intestazione(Icons.Material.Outlined.FamilyRestroom, meta.View_Genitori ? "Genitori" : "Contatti",
                                  meta.View_Genitori ? $"{FormModel.Genitori.Count} di {MaxGenitori}" : null))

                    @if (meta.View_Genitori)
                    {
                        @if (FormModel.Genitori.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Nessun genitore inserito.</MudText>
                        }
                        <MudStack Spacing="2">
                            @foreach (var g in FormModel.Genitori)
                            {
                                var genitore = g;
                                var indice = FormModel.Genitori.IndexOf(genitore) + 1;
                                <MudPaper Outlined="true" Class="pa-3" Style="background: var(--mud-palette-background-gray)">
                                    <div class="d-flex align-center flex-wrap gap-1 mb-2">
                                        <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Genitore @indice</MudText>
                                        @if (genitore.IdGenitore != null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Link">Già registrato</MudChip>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(genitore.Telefono))
                                        {
                                            <MudTooltip Text="Chiama">
                                                <MudIconButton Icon="@Icons.Material.Filled.Call" Size="Size.Small" Color="Color.Success"
                                                               Href="@($"tel:{genitore.Telefono.Replace(" ", "")}")" aria-label="Chiama" />
                                            </MudTooltip>
                                        }
                                        @if (!SolaLettura)
                                        {
                                            <MudTooltip Text="Cerca tra i genitori già registrati">
                                                <MudIconButton Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Small" Color="Color.Primary"
                                                               Disabled="Disabled" OnClick="() => ApriRicercaGenitore(genitore)" aria-label="Cerca genitore" />
                                            </MudTooltip>
                                            <MudTooltip Text="Rimuovi genitore">
                                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                                               Disabled="Disabled" OnClick="() => RimuoviGenitore(genitore)" aria-label="Rimuovi genitore" />
                                            </MudTooltip>
                                        }
                                    </div>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" @bind-Value="genitore.Cognome" Label="Cognome" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                          Required="true" RequiredError="Obbligatorio" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" @bind-Value="genitore.Nome" Label="Nome" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                          Required="true" RequiredError="Obbligatorio" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" @bind-Value="genitore.Telefono" Label="Telefono" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                          InputType="InputType.Telephone" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudRadioGroup T="int?" @bind-Value="genitore.Genere" Required="true" RequiredError="Indica il genere">
                                                <MudRadio T="int?" Value="1" Color="Color.Primary" Dense="true">M</MudRadio>
                                                <MudRadio T="int?" Value="2" Color="Color.Primary" Dense="true">F</MudRadio>
                                            </MudRadioGroup>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudStack>
                        @if (!SolaLettura && FormModel.Genitori.Count < MaxGenitori)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                                       Class="mt-2" Disabled="Disabled" OnClick="AggiungiGenitore">Aggiungi genitore</MudButton>
                        }
                    }

                    @if (meta.View_MailGenitore)
                    {
                        <MudTextField T="string" @bind-Value="FormModel.EmailGenitore" Label="Email genitore" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" InputType="InputType.Email" Class="mt-3"
                                      Validation="@(new Func<string?, string?>(ValidaEmail))"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Email" />
                    }
                </MudPaper>
            }

            @* ================= CLASSE E TAGLIA ================= *@
            @if (meta.View_AnnoScolastico || meta.View_Taglia)
            {
                <MudPaper Outlined="true" Class="pa-3 pa-sm-4">
                    @(Intestazione(Icons.Material.Outlined.School, meta.View_AnnoScolastico && meta.View_Taglia ? "Classe e taglia" : meta.View_AnnoScolastico ? "Classe" : "Taglia"))
                    <MudGrid Spacing="2">
                        @if (meta.View_AnnoScolastico)
                        {
                            <MudItem xs="12" sm="6">
                                <MudSelect T="int?" @bind-Value="FormModel.AnnoScolastico" Label="Anno scolastico" Variant="Variant.Outlined"
                                           Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                           ToStringFunc="@(id => _dati.AnniScolastici.FirstOrDefault(a => a.Id == id)?.Desc ?? (id?.ToString() ?? ""))">
                                    @foreach (var anno in _dati.AnniScolastici)
                                    {
                                        <MudSelectItem T="int?" Value="@anno.Id">@anno.Desc</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        @if (meta.View_Taglia)
                        {
                            <MudItem xs="12" sm="6">
                                <MudSelect T="int?" @bind-Value="FormModel.Taglia" Label="Taglia maglietta" Variant="Variant.Outlined"
                                           Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                           ToStringFunc="@(id => DescTaglia(id))">
                                    @foreach (var taglia in _dati.Taglie)
                                    {
                                        <MudSelectItem T="int?" Value="@taglia.Id">@DescTaglia(taglia.Id)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            }

            @* ================= SETTIMANE ================= *@
            @if (meta.View_Settimane)
            {
                var gruppi = SettimaneModulo.Raggruppa(FormModel.Settimane);
                var scelte = FormModel.Settimane.Count(s => s.IsSelected);
                <MudPaper Outlined="true" Class="pa-3 pa-sm-4">
                    @(Intestazione(Icons.Material.Outlined.DateRange, "Settimane",
                                  scelte == 0 ? "Nessuna scelta" : $"{scelte} {(scelte == 1 ? "scelta" : "scelte")} · {Euro(FormModel.TotaleSettimane)}"))
                    @if (gruppi.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Nessuna settimana configurata per questo evento.</MudText>
                    }
                    <MudStack Spacing="1">
                        @foreach (var gruppo in gruppi)
                        {
                            <div class="d-flex flex-wrap align-center gap-2 py-1">
                                <div class="flex-grow-1" style="min-width: 160px">
                                    <MudText Typo="Typo.body1">@gruppo.Desc</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @gruppo.DataInizio.ToString("dd/MM") – @gruppo.DataFine.ToString("dd/MM/yyyy")
                                    </MudText>
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var v in gruppo.Varianti)
                                    {
                                        var variante = v;
                                        var conPranzo = SettimaneModulo.IsConPranzo(variante);
                                        <MudChip T="int" Value="variante.Id"
                                                 Color="@(variante.IsSelected ? Color.Primary : Color.Default)"
                                                 Variant="@(variante.IsSelected ? Variant.Filled : Variant.Outlined)"
                                                 Icon="@(variante.IsSelected ? Icons.Material.Filled.Check : conPranzo ? Icons.Material.Outlined.Restaurant : Icons.Material.Outlined.NoMeals)"
                                                 Disabled="@((SolaLettura || Disabled) && !variante.IsSelected)"
                                                 Ripple="@(!SolaLettura)"
                                                 OnClick="() => ToggleSettimana(variante)">
                                            @(conPranzo ? "Con pranzo" : "Senza pranzo") · @Euro(conPranzo ? variante.CostoIntero : variante.CostoBase)
                                        </MudChip>
                                    }
                                </div>
                            </div>
                        }
                    </MudStack>
                    @if (scelte > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                            Totale indicativo delle settimane, senza sconti: <b>@Euro(FormModel.TotaleSettimane)</b>
                        </MudText>
                    }
                </MudPaper>
            }

            @* ================= SCHEDA SANITARIA ================= *@
            @if (meta.View_SchedaSanitaria && PuoVedereSanitario)
            {
                <MudPaper Outlined="true" Class="pa-3 pa-sm-4">
                    @(Intestazione(Icons.Material.Outlined.MedicalInformation, "Scheda sanitaria", "Dato riservato"))
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="FormModel.AllergieIntolleranze" Label="Allergie / intolleranze"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="FormModel.PatologieTerapie" Label="Patologie / terapie"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            @* ================= CONSENSI ================= *@
            @if (meta.View_Consensi)
            {
                <MudPaper Outlined="true" Class="pa-3 pa-sm-4">
                    @(Intestazione(Icons.Material.Outlined.FactCheck, "Consensi",
                                  $"{FormModel.ConsensiDisponibili.Count(c => c.IsSelected)} di {FormModel.ConsensiDisponibili.Count}"))
                    @if (FormModel.ConsensiDisponibili.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Nessun consenso configurato per questo evento.</MudText>
                    }
                    @foreach (var c in FormModel.ConsensiDisponibili)
                    {
                        var consenso = c;
                        <div>
                            <MudCheckBox T="bool" @bind-Value="consenso.IsSelected" Color="Color.Primary" Label="@(consenso.Descrizione ?? $"Consenso {consenso.IdTipoConsenso}")" />
                        </div>
                    }
                </MudPaper>
            }

            @* ================= PAGAMENTO ================= *@
            <MudPaper Outlined="true" Class="pa-3 pa-sm-4">
                @(Intestazione(Icons.Material.Outlined.Payments, "Pagamento", FormModel.Pagato ? "Pagato" : "Da pagare"))
                <MudGrid Spacing="2">
                    @if (meta.View_FormatoIscrPagamento)
                    {
                        <MudItem xs="12" sm="6">
                            <MudSelect T="int?" @bind-Value="FormModel.FormatoIscrizioneSelezionato" Label="Formato iscrizione" Variant="Variant.Outlined"
                                       Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                       ToStringFunc="DescFormato">
                                @foreach (var f in Enum.GetValues<FormatoIscrizioneValues>())
                                {
                                    <MudSelectItem T="int?" Value="@((int)f)">@DescFormato((int)f)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="int?" @bind-Value="FormModel.ModalitaPagamentoSelezionata" Label="Modalità pagamento" Variant="Variant.Outlined"
                                       Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                                       ToStringFunc="DescModalita">
                                @foreach (var m in Enum.GetValues<ModalitaPagamentoValues>())
                                {
                                    <MudSelectItem T="int?" Value="@((int)m)">@DescModalita((int)m)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6">
                        <MudSwitch T="bool" @bind-Value="FormModel.Pagato" Color="Color.Success" Label="Pagato" />
                        @if (meta.View_Caparra)
                        {
                            <MudSwitch T="bool" @bind-Value="FormModel.CaparraPagata" Color="Color.Success" Label="Caparra pagata" />
                        }
                        @if (meta.View_ScontoFratelli)
                        {
                            <MudCheckBox T="bool" @bind-Value="FormModel.ScontoFratelli" Color="Color.Primary" Label="Sconto fratelli" />
                        }
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudCheckBox T="bool" @bind-Value="FormModel.Ricevuta" Color="Color.Primary" Label="Richiede ricevuta" />
                        @if (FormModel.Ricevuta)
                        {
                            <MudTextField T="string" @bind-Value="FormModel.DescRicevuta" Label="Intestatario ricevuta"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @* ================= ALTRO ================= *@
            <MudPaper Outlined="true" Class="pa-3 pa-sm-4">
                @(Intestazione(Icons.Material.Outlined.Notes, "Altro"))
                @if (meta.View_IscrizioneNoi)
                {
                    <div>
                        <MudCheckBox T="bool" @bind-Value="FormModel.DaIscrivereAlNoi" Color="Color.Primary" Label="Da iscrivere al NOI" />
                    </div>
                    @if (!FormModel.DaIscrivereAlNoi)
                    {
                        <div class="ml-6">
                            <MudCheckBox T="bool" @bind-Value="FormModel.AltraParrocchia" Color="Color.Primary" Label="Iscritto al NOI in un'altra parrocchia" />
                        </div>
                    }
                }
                @if (meta.View_UscitaAutonoma)
                {
                    <div>
                        <MudCheckBox T="bool" @bind-Value="FormModel.EsceSolo" Color="Color.Primary" Label="Uscita autonoma" />
                    </div>
                }
                @if (meta.View_Priority)
                {
                    <div>
                        <MudCheckBox T="bool" @bind-Value="FormModel.Priority" Color="Color.Warning" Label="Priorità"
                                     CheckedIcon="@Icons.Material.Filled.Star" UncheckedIcon="@Icons.Material.Outlined.StarBorder" />
                    </div>
                }
                <MudTextField T="string" @bind-Value="FormModel.Note" Label="Note" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Lines="3" Class="mt-2" />
            </MudPaper>

            @if (_errori.Count > 0)
            {
                <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="() => _errori.Clear()">
                    <MudText Typo="Typo.subtitle2">Controlla questi campi:</MudText>
                    <ul class="ml-4" style="list-style: disc">
                        @foreach (var errore in _errori)
                        {
                            <li>@errore</li>
                        }
                    </ul>
                </MudAlert>
            }
        </MudStack>
    </MudForm>

    <MudDialog @bind-Visible="_ricercaAperta" Options="_opzioniRicerca">
        <TitleContent>
            <MudText Typo="Typo.h6">Seleziona un genitore</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField T="string" @bind-Value="_filtroGenitore" Placeholder="Cerca per nome o cognome" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            @if (_caricamentoGenitori)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
            }
            else if (_erroreGenitori != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_erroreGenitori</MudAlert>
            }
            else
            {
                var trovati = GenitoriFiltrati.ToList();
                <div style="max-height: 50vh; overflow-y: auto" class="mt-2">
                    <MudList T="GenitoreDto" Dense="true">
                        @foreach (var g in trovati.Take(MaxRisultatiRicerca))
                        {
                            var trovato = g;
                            <MudListItem T="GenitoreDto" Value="trovato" Icon="@Icons.Material.Outlined.Person"
                                         Text="@trovato.NomeCompleto" SecondaryText="@trovato.Telefono"
                                         OnClick="() => SelezionaGenitore(trovato)" />
                        }
                    </MudList>
                    @if (trovati.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">Nessun genitore trovato.</MudText>
                    }
                    else if (trovati.Count > MaxRisultatiRicerca)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary pa-2">
                            Mostrati @MaxRisultatiRicerca di @trovati.Count: affina la ricerca.
                        </MudText>
                    }
                </div>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="ChiudiRicerca">Annulla</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private const int MaxGenitori = 2;
    private const int MaxRisultatiRicerca = 50;
    private static readonly CultureInfo Italiano = CultureInfo.GetCultureInfo("it-IT");

    [Parameter, EditorRequired] public ModuloIscrizioneDto FormModel { get; set; } = new();

    /// <summary>Sola lettura richiesta dalla pagina (es. dettaglio prima di "Modifica").</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Disabilita i campi durante il salvataggio.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Chiamato a ogni modifica dell'utente: i campi sono legati qui dentro, quindi
    /// senza questo la pagina non si ridisegna (es. avviso alla chiusura della scheda).
    /// </summary>
    [Parameter] public EventCallback OnModificato { get; set; }

    private MudForm? _form;
    private DatiModulo? _dati;
    private bool _caricamento = true;
    private string? _erroreCaricamento;
    private ModuloIscrizioneDto? _modelloPreparato;
    private List<string> _errori = new();

    /// <summary>Senza il permesso di modifica il modulo è sempre in sola lettura.</summary>
    private bool SolaLettura => ReadOnly || !AppState.Can(Permessi.IscrittiEdit);

    private bool PuoVedereSanitario => AppState.CanAny(Permessi.IscrittiSanitario, Permessi.IscrittiEdit);

    /// <summary>True quando i dati di riferimento sono caricati e il modulo è utilizzabile.</summary>
    public bool Pronto => !_caricamento && _erroreCaricamento == null && _dati != null;

    protected override async Task OnInitializedAsync()
    {
        await CaricaAsync();
    }

    protected override void OnParametersSet()
    {
        if (Pronto && !ReferenceEquals(_modelloPreparato, FormModel))
            PreparaModello();
    }

    private async Task CaricaAsync()
    {
        _caricamento = true;
        _erroreCaricamento = null;
        try
        {
            _dati = await ViewModel.CaricaDatiAsync();
            PreparaModello();
        }
        catch (Exception ex)
        {
            _erroreCaricamento = ex.Message;
        }
        finally
        {
            _caricamento = false;
        }
    }

    /// <summary>Un modulo nuovo riceve tutte le settimane e i consensi dell'evento (non selezionati).</summary>
    private void PreparaModello()
    {
        if (_dati == null)
            return;

        FormModel.Genitori ??= new();

        if (FormModel.Settimane == null || FormModel.Settimane.Count == 0)
        {
            FormModel.Settimane = _dati.Settimane.Select(s => new Settimana
            {
                Id = s.Id,
                event_id = s.event_id,
                Desc = s.Desc,
                DescBase = s.DescBase,
                CostoBase = s.CostoBase,
                CostoIntero = s.CostoIntero,
                DataInizio = s.DataInizio,
                DataFine = s.DataFine,
                IsSelected = false
            }).ToList();
        }

        if (FormModel.ConsensiDisponibili == null || FormModel.ConsensiDisponibili.Count == 0)
        {
            FormModel.ConsensiDisponibili = _dati.Consensi
                .Select(c => new ConsensoDto { IdTipoConsenso = c.IdTipoConsenso, Descrizione = c.Descrizione })
                .ToList();
        }

        _modelloPreparato = FormModel;
        _errori.Clear();
    }

    /// <summary>
    /// Evidenzia i campi non validi e applica ModuloIscrizioneValidator, che resta
    /// il riferimento. Restituisce true se si può salvare.
    /// </summary>
    public async Task<bool> ValidaAsync()
    {
        if (!Pronto)
        {
            _errori = new() { "Il modulo non è ancora pronto." };
            StateHasChanged();
            return false;
        }

        if (_form != null)
            await _form.ValidateAsync();

        // Con i metadati i controlli ignorano le sezioni nascoste dall'evento
        _errori = ModuloIscrizioneValidator.Validate(FormModel, _dati?.Metadata)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        StateHasChanged();
        return _errori.Count == 0;
    }

    private RenderFragment Intestazione(string icona, string titolo, string? info = null) =>
        @<div class="d-flex align-center gap-2 mb-3">
            <MudIcon Icon="@icona" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Class="flex-grow-1"><b>@titolo</b></MudText>
            @if (!string.IsNullOrEmpty(info))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@info</MudText>
            }
        </div>;

    private string? EtaDesc
    {
        get
        {
            if (FormModel.DataNascita is not DateTime nascita || nascita > DateTime.Today)
                return null;
            var oggi = DateTime.Today;
            var eta = oggi.Year - nascita.Year - (oggi.DayOfYear < nascita.DayOfYear ? 1 : 0);
            return eta == 1 ? "1 anno" : $"{eta} anni";
        }
    }

    private static string Euro(decimal? valore) => valore?.ToString("C", Italiano) ?? "–";

    private string DescTaglia(int? id)
    {
        var taglia = _dati?.Taglie.FirstOrDefault(t => t.Id == id);
        if (taglia == null)
            return id?.ToString() ?? "";
        return string.IsNullOrWhiteSpace(taglia.Descrizione) ? taglia.Codice : taglia.Descrizione;
    }

    private static string DescFormato(int? valore) => DescEnum<FormatoIscrizioneValues>(valore);

    private static string DescModalita(int? valore) => DescEnum<ModalitaPagamentoValues>(valore);

    private static string DescEnum<TEnum>(int? valore) where TEnum : struct, Enum
    {
        if (valore == null || !Enum.IsDefined(typeof(TEnum), valore.Value))
            return valore?.ToString() ?? "";
        var nome = Enum.GetName(typeof(TEnum), valore.Value) ?? "";
        return nome == nameof(ModalitaPagamentoValues.Pos) ? "POS" : nome;
    }

    private static string? ValidaEmail(string? email) =>
        ModuloIscrizioneValidator.IsEmailValida(email) ? null : "Indirizzo email non valido";

    private Task NotificaModificaAsync() => OnModificato.InvokeAsync();

    private async Task ToggleSettimana(Settimana variante)
    {
        if (SolaLettura || Disabled)
            return;
        SettimaneModulo.Seleziona(FormModel.Settimane, variante, !variante.IsSelected);
        await NotificaModificaAsync();
    }

    private async Task AggiungiGenitore()
    {
        if (FormModel.Genitori.Count < MaxGenitori)
        {
            FormModel.Genitori.Add(new GenitoreDto());
            await NotificaModificaAsync();
        }
    }

    private async Task RimuoviGenitore(GenitoreDto genitore)
    {
        FormModel.Genitori.Remove(genitore);
        await NotificaModificaAsync();
    }

    // ---------- Ricerca genitori già registrati (solo evento corrente) ----------

    private readonly DialogOptions _opzioniRicerca = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private bool _ricercaAperta;
    private bool _caricamentoGenitori;
    private string? _erroreGenitori;
    private List<GenitoreDto> _genitoriRegistrati = new();
    private string? _filtroGenitore;
    private GenitoreDto? _genitoreCorrente;

    private IEnumerable<GenitoreDto> GenitoriFiltrati
    {
        get
        {
            var parole = (_filtroGenitore ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return _genitoriRegistrati.Where(g => parole.All(p =>
                (g.Nome ?? "").Contains(p, StringComparison.CurrentCultureIgnoreCase) ||
                (g.Cognome ?? "").Contains(p, StringComparison.CurrentCultureIgnoreCase) ||
                (g.Telefono ?? "").Contains(p, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private async Task ApriRicercaGenitore(GenitoreDto genitore)
    {
        _genitoreCorrente = genitore;
        _filtroGenitore = null;
        _erroreGenitori = null;
        _ricercaAperta = true;
        _caricamentoGenitori = true;
        StateHasChanged();
        try
        {
            _genitoriRegistrati = await ViewModel.GetGenitoriListAsync();
        }
        catch (Exception ex)
        {
            _erroreGenitori = "Impossibile caricare i genitori: " + ex.Message;
        }
        finally
        {
            _caricamentoGenitori = false;
        }
    }

    private async Task SelezionaGenitore(GenitoreDto trovato)
    {
        var modificato = _genitoreCorrente != null;
        if (_genitoreCorrente != null)
        {
            _genitoreCorrente.IdGenitore = trovato.IdGenitore;
            _genitoreCorrente.Nome = trovato.Nome;
            _genitoreCorrente.Cognome = trovato.Cognome;
            _genitoreCorrente.Telefono = trovato.Telefono;
            _genitoreCorrente.Genere = trovato.Genere;
            _genitoreCorrente.Existing = true;
        }
        ChiudiRicerca();
        if (modificato)
            await NotificaModificaAsync();
    }

    private void ChiudiRicerca()
    {
        _ricercaAperta = false;
        _genitoreCorrente = null;
        _genitoriRegistrati = new();
    }
}
