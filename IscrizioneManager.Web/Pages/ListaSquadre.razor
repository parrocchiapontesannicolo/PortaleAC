@page "/squadre"
@using IscrizioneManager.Web.Sortable
@using IscrizioniManager.Models
@using IscrizioneManager.Core.Services
@using IscrizioneManager.Core.Models
@using IscrizioneManager.Core.Logic
@inject NavigationManager Navigation
@inject AppState AppState

<link href="css/ListaSquadre.css" rel="stylesheet" />

<LoadingView @ref="LoadingOverlay" />

<div class="header-iscrizione">
    <h2>Squadre</h2>
    <div class="editing-buttons">
        @if (isSaving)
        {
            <span class="saving-indicator">Salvataggio...</span>
        }
        @if (!IsReadOnly)
        {
            <button class="btn-squadre" @onclick="RidistriubisciSquadre">Ridistribuisci automaticamente</button>
        }
    </div>
    <button class="btn-chiudi" @onclick="TornaIndietro" title="Chiudi">×</button>
</div>

<div class="squadre-container">

    @foreach (var s in Squadre)
    {
        <div class="squadra-card @(s.Id == 0 ? "full-width" : "")">
            <div class="squadra-header"
                 style="background-color:@s.Color; color:@GetTextColor(s.Color)"
                 @onclick="() => s.IsExpanded = !s.IsExpanded">
                <span>@s.Nome (@s.Bambini.Count)</span>
                <span class="chevron @(s.IsExpanded ? "open" : "")">&#9658;</span>
            </div>

            <div class="squadra-body @(s.IsExpanded ? "" : "collapsed")">
                @if (IsReadOnly)
                {
                    @foreach (var item in s.Bambini)
                    {
                        <div class="card has-border has-background-white squadra-item">
                            <p class="is-size-4 p-2">@item.Cognome @item.Nome@(string.IsNullOrEmpty(item.AnnoDesc) ? "" : $" ({item.AnnoDesc})")</p>
                        </div>
                    }
                }
                else
                {
                    <SortableList Items="s.Bambini"
                                  Group="bambiniGroup"
                                  Id="@s.Id.ToString()"
                                  OnRemove="@OnBambinoMoved"
                                  Context="item">
                        <SortableItemTemplate>
                            <div class="card has-border has-background-white squadra-item">
                                <p class="is-size-4 p-2">@item.Cognome @item.Nome@(string.IsNullOrEmpty(item.AnnoDesc) ? "" : $" ({item.AnnoDesc})")</p>
                            </div>
                        </SortableItemTemplate>
                    </SortableList>
                }
            </div>
        </div>
    }

</div>

@code {
    private LoadingView? LoadingOverlay;

    private List<Squadra> Squadre = new();
    private bool isSaving = false;
    private bool IsReadOnly = false;

    protected override async Task OnInitializedAsync()
    {
        LoadingOverlay?.Start();
        Squadre = await SquadraBambinoController.GetSquadreAsync();
        IsReadOnly = !AppState.Can(Permessi.SquadreEdit);
        LoadingOverlay?.Stop();
    }

    private async Task OnBambinoMoved((int oldIndex, int newIndex, int? from, int? to) indices)
    {
        int fromId = indices.from ?? 0;
        int toId = indices.to ?? 0;

        var fromSquadra = Squadre.Single(x => x.Id == fromId);
        var toSquadra = Squadre.Single(x => x.Id == toId);
        var bambino = fromSquadra.Bambini[indices.oldIndex];

        toSquadra.Bambini.Insert(indices.newIndex, bambino);
        fromSquadra.Bambini.Remove(bambino);
        StateHasChanged();

        isSaving = true;
        StateHasChanged();
        await SquadraBambinoController.SetSquadraAsync(bambino.Id, toId);
        isSaving = false;
        StateHasChanged();
    }

    private async Task RidistriubisciSquadre()
    {
        SquadraDistributor.Distribuisci(Squadre);
        isSaving = true;
        StateHasChanged();
        await SquadraBambinoController.SaveAllAssignmentsAsync(Squadre);
        isSaving = false;
        StateHasChanged();
    }

    private void TornaIndietro()
    {
        Navigation.NavigateTo("", true);
    }

    private string GetTextColor(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex) || hex.Length < 7 || !hex.StartsWith("#"))
            return "#000000";

        int r = int.TryParse(hex.Substring(1, 2), System.Globalization.NumberStyles.HexNumber, null, out var rr) ? rr : 0;
        int g = int.TryParse(hex.Substring(3, 2), System.Globalization.NumberStyles.HexNumber, null, out var gg) ? gg : 0;
        int b = int.TryParse(hex.Substring(5, 2), System.Globalization.NumberStyles.HexNumber, null, out var bb) ? bb : 0;

        double luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
        return luminance > 0.5 ? "#000000" : "#FFFFFF";
    }
}
