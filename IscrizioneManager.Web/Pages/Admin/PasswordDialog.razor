@* Cambio password di un account condiviso (Edge Function admin-accounts). *@

<MudDialog>
    <DialogContent>
        <EditForm Model="this" OnSubmit="Salva">
            <MudStack Spacing="3">
                <MudText Typo="Typo.body2">
                    Nuova password per <b>@Account.Nome</b>. Ricordati di comunicarla a tutto il gruppo che usa questo account.
                </MudText>

                <CampoPassword @bind-Value="_password" Label="Nuova password" Disabled="_inCorso" />

                <MudAlert Severity="Severity.Info" Dense="true">
                    Chi è già collegato potrebbe restare dentro fino all'uscita. Per bloccare subito l'accesso disattiva l'account.
                </MudAlert>

                @if (!string.IsNullOrEmpty(_errore))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_errore</MudAlert>
                }
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()" Disabled="_inCorso">Annulla</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salva"
                   Disabled="@(_inCorso || AdminLogica.ValidaPassword(_password) != null)">
            @if (_inCorso)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Cambia password
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public AppAccount Account { get; set; } = default!;

    private string _password = string.Empty;
    private bool _inCorso;
    private string? _errore;

    private async Task Salva()
    {
        if (_inCorso || AdminLogica.ValidaPassword(_password) != null)
            return;

        _inCorso = true;
        _errore = null;
        try
        {
            await AdminController.CambiaPasswordAsync(Account.Id, _password);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _errore = AdminLogica.MessaggioErrore(ex);
        }
        finally
        {
            _inCorso = false;
        }
    }
}
