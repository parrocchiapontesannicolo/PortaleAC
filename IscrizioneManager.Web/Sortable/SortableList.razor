@* Lista trascinabile generica basata su SortableJS.
   Il componente non modifica Items: notifica OnUpdate / OnRemove e lascia
   al chiamante l'aggiornamento del modello. *@
@typeparam T
@implements IAsyncDisposable
@inject IJSRuntime JS

<link href="css/SortableList.css" rel="stylesheet" />
<div id="@Id" class="@($"sortable-list {Class}".Trim())" data-empty="@EmptyText">
    @foreach (var item in Items)
    {
        <div class="sortable-item" @key="KeySelector is null ? item : KeySelector(item)">
            @SortableItemTemplate?.Invoke(item)
        </div>
    }
</div>

@code {
    [Parameter]
    public RenderFragment<T>? SortableItemTemplate { get; set; }

    [Parameter, EditorRequired]
    public List<T> Items { get; set; } = new();

    /// <summary>Chiave stabile per elemento (consigliata): evita che Blazor riusi il DOM sbagliato.</summary>
    [Parameter]
    public Func<T, object>? KeySelector { get; set; }

    /// <summary>Spostamento all'interno della stessa lista.</summary>
    [Parameter]
    public EventCallback<(int oldIndex, int newIndex)> OnUpdate { get; set; }

    /// <summary>Spostamento verso un'altra lista: from / to sono gli Id delle liste.</summary>
    [Parameter]
    public EventCallback<(int oldIndex, int newIndex, string? from, string? to)> OnRemove { get; set; }

    /// <summary>Errore di inizializzazione (es. SortableJS non caricato). Se non gestito viene rilanciato.</summary>
    [Parameter]
    public EventCallback<Exception> OnError { get; set; }

    /// <summary>Id dell'elemento HTML (deve essere unico nella pagina).</summary>
    [Parameter]
    public string Id { get; set; } = $"sortable-{Guid.NewGuid():N}";

    [Parameter]
    public string Group { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string? Pull { get; set; }

    [Parameter]
    public bool Put { get; set; } = true;

    [Parameter]
    public bool Sort { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string Handle { get; set; } = string.Empty;

    /// <summary>Selettore CSS di elementi che non avviano il trascinamento (es. pulsanti).</summary>
    [Parameter]
    public string? Filter { get; set; }

    [Parameter]
    public bool ForceFallback { get; set; } = true;

    /// <summary>Millisecondi di pressione prima del trascinamento sui dispositivi touch.</summary>
    [Parameter]
    public int TouchDelay { get; set; } = 200;

    /// <summary>Testo mostrato quando la lista è vuota.</summary>
    [Parameter]
    public string? EmptyText { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private DotNetObjectReference<SortableList<T>>? _selfReference;
    private IJSObjectReference? _module;
    private IJSObjectReference? _sortable;
    private bool _disabledApplicato;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _selfReference = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/SortableList.js");
                var options = new
                {
                    Group,
                    Pull,
                    Put,
                    Sort,
                    Disabled,
                    Handle,
                    Filter,
                    ForceFallback,
                    TouchDelay
                };
                _sortable = await _module.InvokeAsync<IJSObjectReference>("init", Id, options, _selfReference);
                _disabledApplicato = Disabled;
            }
            catch (Exception ex)
            {
                if (OnError.HasDelegate)
                    await OnError.InvokeAsync(ex);
                else
                    throw;
            }
        }
        else if (_module is not null && _sortable is not null && _disabledApplicato != Disabled)
        {
            _disabledApplicato = Disabled;
            await _module.InvokeVoidAsync("setDisabled", _sortable, Disabled);
        }
    }

    [JSInvokable]
    public Task OnUpdateJS(int oldIndex, int newIndex)
        => OnUpdate.InvokeAsync((oldIndex, newIndex));

    [JSInvokable]
    public Task OnRemoveJS(int oldIndex, int newIndex, string? from, string? to)
        => OnRemove.InvokeAsync((oldIndex, newIndex, from, to));

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _sortable is not null)
                await _module.InvokeVoidAsync("destroy", _sortable);
            if (_sortable is not null)
                await _sortable.DisposeAsync();
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuito/pagina già chiusi: niente da liberare lato JS
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"SortableList: errore in chiusura ({ex.Message})");
        }
        finally
        {
            _selfReference?.Dispose();
        }
    }
}
