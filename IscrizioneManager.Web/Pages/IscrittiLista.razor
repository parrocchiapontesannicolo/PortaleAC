@page "/iscritti"
@using IscrizioneManager.Core.Dtos
@using IscrizioneManager.Core.Models
@using IscrizioniManager.Controllers
@inject AppState AppState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Iscritti - Portale AC</PageTitle>

<PaginaProtetta Permessi="@(new[] { Permessi.IscrittiView, Permessi.IscrittiEdit, Permessi.IscrittiPagamenti })">
    <div class="d-flex align-center flex-wrap gap-2 mb-3">
        <MudText Typo="Typo.h5" Class="flex-grow-1">Iscritti</MudText>
        <MudTooltip Text="Aggiorna">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Disabled="_caricamento" OnClick="CaricaAsync" aria-label="Aggiorna" />
        </MudTooltip>
        @if (AppState.Can(Permessi.IscrittiEdit))
        {
            <MudButton Href="@Rotte.NuovaIscrizione" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd">Nuova iscrizione</MudButton>
        }
    </div>

    @if (_caricamento)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        <MudStack Spacing="2">
            @for (var i = 0; i < 6; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
            }
        </MudStack>
    }
    else if (_errore != null)
    {
        <MudAlert Severity="Severity.Error">
            Impossibile caricare gli iscritti: @_errore
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="ml-2" OnClick="CaricaAsync">Riprova</MudButton>
        </MudAlert>
    }
    else
    {
        @* ---------- Riepilogo (i chip sono anche filtri rapidi) ---------- *@
        <div class="d-flex flex-wrap gap-1 mb-3">
            <MudChip T="string" Icon="@Icons.Material.Outlined.People" Color="Color.Primary"
                     Variant="@(_filtro.FiltriAttivi == 0 ? Variant.Filled : Variant.Outlined)" OnClick="AzzeraFiltri">
                Totale @_riepilogo.Totale
            </MudChip>
            <MudChip T="string" Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success"
                     Variant="@(_filtro.Pagato == true ? Variant.Filled : Variant.Outlined)" OnClick="() => FiltroRapidoPagato(true)">
                Pagati @_riepilogo.Pagati
            </MudChip>
            <MudChip T="string" Icon="@Icons.Material.Outlined.PendingActions" Color="Color.Warning"
                     Variant="@(_filtro.Pagato == false ? Variant.Filled : Variant.Outlined)" OnClick="() => FiltroRapidoPagato(false)">
                Da pagare @_riepilogo.DaPagare
            </MudChip>
            @if (_metadata.View_Caparra)
            {
                <MudChip T="string" Icon="@Icons.Material.Outlined.Savings" Color="Color.Info"
                         Variant="@(_filtro.Caparra == true ? Variant.Filled : Variant.Outlined)" OnClick="FiltroRapidoCaparra">
                    Caparra @_riepilogo.CaparraPagata
                </MudChip>
            }
            @if (_metadata.View_Priority)
            {
                <MudChip T="string" Icon="@Icons.Material.Outlined.Star" Color="Color.Secondary"
                         Variant="@(_filtro.Priority == true ? Variant.Filled : Variant.Outlined)" OnClick="FiltroRapidoPriority">
                    Priorità @_riepilogo.Priority
                </MudChip>
            }
            @foreach (var c in _riepilogo.PerAnno)
            {
                var conteggio = c;
                var valore = conteggio.Anno ?? FiltroIscritti.AnnoNonIndicato;
                <MudChip T="string" Color="Color.Default"
                         Variant="@(_filtro.Anno == valore ? Variant.Filled : Variant.Outlined)" OnClick="() => FiltroRapidoAnno(valore)">
                    @conteggio.Desc @conteggio.Conteggio
                </MudChip>
            }
        </div>

        @* ---------- Filtri ---------- *@
        <MudGrid Spacing="2" Class="mb-1">
            <MudItem xs="12" md="4">
                <MudTextField T="string" @bind-Value="_filtro.Testo" @bind-Value:after="Applica" DebounceInterval="250"
                              Placeholder="Cerca nome, cognome, classe, note…" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudSelect T="int?" @bind-Value="_filtro.Anno" @bind-Value:after="Applica" Label="Classe" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter" ToStringFunc="DescAnno">
                    @foreach (var anno in _anniScolastici)
                    {
                        <MudSelectItem T="int?" Value="@anno.Id">@anno.Desc</MudSelectItem>
                    }
                    @if (_riepilogo.PerAnno.Any(c => c.Anno == null))
                    {
                        <MudSelectItem T="int?" Value="@((int?)FiltroIscritti.AnnoNonIndicato)">Non indicato</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudSelect T="bool?" @bind-Value="_filtro.Pagato" @bind-Value:after="Applica" Label="Pagamento" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                           ToStringFunc="@(v => v == null ? "" : v.Value ? "Pagati" : "Da pagare")">
                    <MudSelectItem T="bool?" Value="true">Pagati</MudSelectItem>
                    <MudSelectItem T="bool?" Value="false">Da pagare</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (_metadata.View_Caparra)
            {
                <MudItem xs="6" sm="4" md="2">
                    <MudSelect T="bool?" @bind-Value="_filtro.Caparra" @bind-Value:after="Applica" Label="Caparra" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                               ToStringFunc="@(v => v == null ? "" : v.Value ? "Versata" : "Non versata")">
                        <MudSelectItem T="bool?" Value="true">Versata</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">Non versata</MudSelectItem>
                    </MudSelect>
                </MudItem>
            }
            @if (_metadata.View_Priority)
            {
                <MudItem xs="6" sm="4" md="2">
                    <MudSelect T="bool?" @bind-Value="_filtro.Priority" @bind-Value:after="Applica" Label="Priorità" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Clearable="true" AnchorOrigin="Origin.BottomCenter"
                               ToStringFunc="@(v => v == null ? "" : v.Value ? "Con priorità" : "Senza priorità")">
                        <MudSelectItem T="bool?" Value="true">Con priorità</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">Senza priorità</MudSelectItem>
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="6" sm="4" md="2">
                <MudSelect T="OrdinamentoIscritti" @bind-Value="_filtro.Ordinamento" @bind-Value:after="Applica" Label="Ordina per"
                           Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" ToStringFunc="DescOrdinamento">
                    @foreach (var o in Enum.GetValues<OrdinamentoIscritti>())
                    {
                        <MudSelectItem T="OrdinamentoIscritti" Value="o">@DescOrdinamento(o)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <div class="d-flex align-center flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @(_visibili.Count == _tutti.Count ? $"{_tutti.Count} iscritti" : $"{_visibili.Count} di {_tutti.Count} iscritti")
            </MudText>
            @if (_filtro.FiltriAttivi > 0)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="AzzeraFiltri">
                    Azzera filtri
                </MudButton>
            }
        </div>

        @* ---------- Schermi larghi: tabella ---------- *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudTable T="IscrittoListaItem" Items="_visibili" Hover="true" Dense="true" Outlined="true" Elevation="0"
                      Breakpoint="Breakpoint.None" RowsPerPage="50" OnRowClick="OnRowClick"
                      RowClass="@(PuoAprire ? "cursor-pointer" : null)">
                <HeaderContent>
                    <MudTh><MudTableSortLabel T="IscrittoListaItem" SortBy="@(x => x.Cognome)">Cognome</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="IscrittoListaItem" SortBy="@(x => x.Nome)">Nome</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="IscrittoListaItem" SortBy="@(x => x.DataNascita ?? DateTime.MaxValue)">Nato il</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="IscrittoListaItem" SortBy="@(x => x.Anno ?? int.MaxValue)">Classe</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel T="IscrittoListaItem" SortBy="@(x => x.Pagato)">Pagato</MudTableSortLabel></MudTh>
                    @if (_metadata.View_Caparra)
                    {
                        <MudTh><MudTableSortLabel T="IscrittoListaItem" SortBy="@(x => x.CaparraPagata)">Caparra</MudTableSortLabel></MudTh>
                    }
                    @if (_metadata.View_Priority)
                    {
                        <MudTh><MudTableSortLabel T="IscrittoListaItem" SortBy="@(x => x.Priority)">Priorità</MudTableSortLabel></MudTh>
                    }
                    <MudTh>Note</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Cognome"><b>@context.Cognome</b></MudTd>
                    <MudTd DataLabel="Nome">@context.Nome</MudTd>
                    <MudTd DataLabel="Nato il">@context.DataNascitaDesc</MudTd>
                    <MudTd DataLabel="Classe">@context.AnnoDesc</MudTd>
                    <MudTd DataLabel="Pagato">@StatoPagato(context)</MudTd>
                    @if (_metadata.View_Caparra)
                    {
                        <MudTd DataLabel="Caparra">
                            @if (context.CaparraPagata)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Info" Size="Size.Small" Title="Caparra versata" />
                            }
                        </MudTd>
                    }
                    @if (_metadata.View_Priority)
                    {
                        <MudTd DataLabel="Priorità">
                            @if (context.Priority)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Secondary" Size="Size.Small" Title="Priorità" />
                            }
                        </MudTd>
                    }
                    <MudTd DataLabel="Note">
                        <div title="@context.Note" style="max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">
                            <MudText Typo="Typo.body2" Inline="true">@context.Note</MudText>
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4">@TestoNessunRisultato</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100, int.MaxValue })" RowsPerPageString="Righe per pagina:"
                                   AllItemsText="Tutte" InfoFormat="{first_item}-{last_item} di {all_items}" />
                </PagerContent>
            </MudTable>
        </MudHidden>

        @* ---------- Telefono: schede ---------- *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            @if (_visibili.Count == 0)
            {
                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.body2">@TestoNessunRisultato</MudText>
                </MudPaper>
            }
            <MudStack Spacing="2">
                @foreach (var i in _visibili.Take(_schedeMostrate))
                {
                    var item = i;
                    <MudPaper Outlined="true" Class="@($"pa-3 {(PuoAprire ? "cursor-pointer" : "")}")" @onclick="() => Apri(item)">
                        <div class="d-flex align-center gap-2">
                            <div class="flex-grow-1" style="min-width: 0">
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.subtitle1" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap">
                                        <b>@item.Cognome</b> @item.Nome
                                    </MudText>
                                    @if (_metadata.View_Priority && item.Priority)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Secondary" Size="Size.Small" Title="Priorità" />
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@DettaglioScheda(item)</MudText>
                            </div>
                            @StatoPagato(item)
                        </div>
                        @if (_metadata.View_Caparra && item.CaparraPagata)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Outlined.Savings" Class="ml-0 mt-1">Caparra versata</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Note))
                        {
                            <MudText Typo="Typo.caption" Class="d-block mt-1"
                                     Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap">
                                <MudIcon Icon="@Icons.Material.Outlined.StickyNote2" Size="Size.Small" Style="vertical-align: middle; font-size: 1rem" />
                                @item.Note
                            </MudText>
                        }
                    </MudPaper>
                }
            </MudStack>
            @if (_visibili.Count > _schedeMostrate)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mt-3"
                           OnClick="() => _schedeMostrate += PassoSchede">
                    Mostra altri (@(_visibili.Count - _schedeMostrate))
                </MudButton>
            }
        </MudHidden>
    }
</PaginaProtetta>

@code {
    private const int PassoSchede = 40;

    // Filtri ricordati finché resta aperta l'app, per tornare dalla scheda alla stessa lista
    private static FiltroIscritti? _filtroSalvato;
    private static int? _eventoFiltroSalvato;

    private bool _caricamento = true;
    private string? _errore;
    private EventoMetadata _metadata = new();
    private List<AnnoScolastico> _anniScolastici = new();
    private List<IscrittoListaItem> _tutti = new();
    private List<IscrittoListaItem> _visibili = new();
    private RiepilogoIscritti _riepilogo = new();
    private FiltroIscritti _filtro = new();
    private int _schedeMostrate = PassoSchede;
    private readonly HashSet<int> _inAggiornamento = new();

    private bool PuoAprire => AppState.CanAny(Permessi.IscrittiView, Permessi.IscrittiEdit);
    private bool PuoSegnarePagato => AppState.CanAny(Permessi.IscrittiPagamenti, Permessi.IscrittiEdit);

    private string TestoNessunRisultato => _tutti.Count == 0
        ? "Nessun iscritto in questo evento."
        : "Nessun iscritto corrisponde ai filtri.";

    protected override async Task OnInitializedAsync()
    {
        // Senza sessione o evento PaginaProtetta reindirizza: inutile interrogare il server
        if (!AppState.IsAuthenticated || !AppState.HasEvento)
            return;

        if (_filtroSalvato != null && _eventoFiltroSalvato == AppState.EventoCorrente?.EventId)
            _filtro = _filtroSalvato.Clona();

        await CaricaAsync();
    }

    private async Task CaricaAsync()
    {
        _caricamento = true;
        _errore = null;
        try
        {
            var dati = await IscrittiListaController.CaricaListaAsync();
            _metadata = dati.Metadata;
            _anniScolastici = dati.AnniScolastici;
            _tutti = dati.Iscritti;
            Applica();
        }
        catch (Exception ex)
        {
            _errore = ex.Message;
        }
        finally
        {
            _caricamento = false;
        }
    }

    private void Applica() => AggiornaVista(ricominciaSchede: true);

    private void AggiornaVista(bool ricominciaSchede)
    {
        _visibili = IscrittiListaController.Filtra(_tutti, _filtro);
        _riepilogo = IscrittiListaController.Riepiloga(_tutti, _anniScolastici);
        if (ricominciaSchede)
            _schedeMostrate = PassoSchede;
        _filtroSalvato = _filtro.Clona();
        _eventoFiltroSalvato = AppState.EventoCorrente?.EventId;
    }

    private void AzzeraFiltri()
    {
        _filtro.Azzera();
        Applica();
    }

    private void FiltroRapidoPagato(bool valore)
    {
        _filtro.Pagato = _filtro.Pagato == valore ? null : valore;
        Applica();
    }

    private void FiltroRapidoCaparra()
    {
        _filtro.Caparra = _filtro.Caparra == true ? null : true;
        Applica();
    }

    private void FiltroRapidoPriority()
    {
        _filtro.Priority = _filtro.Priority == true ? null : true;
        Applica();
    }

    private void FiltroRapidoAnno(int anno)
    {
        _filtro.Anno = _filtro.Anno == anno ? null : anno;
        Applica();
    }

    private string DescAnno(int? anno) => anno switch
    {
        null => "",
        FiltroIscritti.AnnoNonIndicato => "Non indicato",
        _ => _anniScolastici.FirstOrDefault(a => a.Id == anno)?.Desc ?? anno.Value.ToString(),
    };

    private static string DescOrdinamento(OrdinamentoIscritti o) => o switch
    {
        OrdinamentoIscritti.Recenti => "Ultimi inseriti",
        OrdinamentoIscritti.Anno => "Classe",
        OrdinamentoIscritti.DataNascita => "Data di nascita",
        _ => "Cognome",
    };

    private static string DettaglioScheda(IscrittoListaItem item) =>
        string.Join(" · ", new[] { item.AnnoDesc, item.DataNascita != null ? $"nato il {item.DataNascitaDesc}" : "" }
            .Where(s => !string.IsNullOrEmpty(s)));

    private void OnRowClick(TableRowClickEventArgs<IscrittoListaItem> args)
    {
        if (args.Item != null)
            Apri(args.Item);
    }

    private void Apri(IscrittoListaItem item)
    {
        if (PuoAprire)
            Navigation.NavigateTo($"{Rotte.Iscritti}/{item.IdBambino}");
    }

    /// <summary>Interruttore "pagato" per chi può modificarlo, altrimenti solo lo stato.</summary>
    private RenderFragment StatoPagato(IscrittoListaItem item) =>
        @<div @onclick:stopPropagation="true">
            @if (PuoSegnarePagato && item.IdIscrizione != null)
            {
                <MudTooltip Text="@(item.Pagato ? "Pagato: tocca per segnare da pagare" : "Da pagare: tocca per segnare pagato")">
                    <MudSwitch T="bool" Value="item.Pagato" ValueChanged="@((bool v) => CambiaPagatoAsync(item, v))"
                               Color="Color.Success" UncheckedColor="Color.Warning" Disabled="_inAggiornamento.Contains(item.IdBambino)"
                               aria-label="@($"Pagato {item.NomeCompleto}")" />
                </MudTooltip>
            }
            else if (item.Pagato)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.CheckCircle">Pagato</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Icon="@Icons.Material.Outlined.PendingActions">Da pagare</MudChip>
            }
        </div>;

    /// <summary>Aggiornamento ottimistico: in caso di errore torna al valore precedente.</summary>
    private async Task CambiaPagatoAsync(IscrittoListaItem item, bool valore)
    {
        if (item.IdIscrizione is not int idIscrizione || item.Pagato == valore || !_inAggiornamento.Add(item.IdBambino))
            return;

        var precedente = item.Pagato;
        item.Pagato = valore;
        await InvokeAsync(StateHasChanged);
        try
        {
            await IscrittiListaController.AggiornaPagatoAsync(idIscrizione, valore);
            Snackbar.Add($"{item.NomeCompleto}: {(valore ? "pagato" : "da pagare")}", Severity.Success, opzioni =>
            {
                opzioni.Action = "Annulla";
                opzioni.OnClick = _ => CambiaPagatoAsync(item, precedente);
            });
        }
        catch (Exception ex)
        {
            item.Pagato = precedente;
            Snackbar.Add($"Pagamento di {item.NomeCompleto} non aggiornato: {ex.Message}", Severity.Error);
        }
        finally
        {
            _inAggiornamento.Remove(item.IdBambino);
            AggiornaVista(ricominciaSchede: false);
            await InvokeAsync(StateHasChanged);
        }
    }
}
